{
  "name": "linote-hexo",
  "version": "2.0.0",
  "private": true,
  "description": "Linote static blog built with Hexo",
  "hexo": {
    "version": "8.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "hexo clean",
    "build": "hexo clean && hexo generate",
    "generate": "hexo generate",
    "server": "hexo server -i 0.0.0.0 -p 4000",
    "new": "hexo new",
    "test": "node --test editor-worker/test/*.test.js"
  },
  "devDependencies": {
    "hexo": "8.1.2",
    "hexo-cli": "4.3.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-server": "3.0.0"
  }
}
