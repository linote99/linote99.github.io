<%
const currentPath = String(page.path || '');
const activeHome = is_home();
const activeArchive = is_archive() || currentPath.startsWith('archives/');
const activeTags = is_tag() || currentPath.startsWith('tags/');
const activeLinks = currentPath.startsWith('links/');
const activeAbout = currentPath.startsWith('about/');
const activeTitle = page.title ? `${page.title} | Lino笔记` : 'Lino笔记 — 技术笔记与日常记录';
const activeDescription = page.description || page.summary || config.description;
const footerCopy = site.data.footer;
const rewardCopy = site.data.reward;
%><!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f5f1">
  <meta name="description" content="<%= activeDescription %>">
  <meta property="og:title" content="<%= activeTitle %>">
  <meta property="og:description" content="<%= activeDescription %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <link rel="canonical" href="<%- config.url %><%- url_for(page.path) %>">
  <meta property="og:url" content="<%- config.url %><%- url_for(page.path) %>">
  <title><%= activeTitle %></title>
  <link rel="icon" type="image/png" href="<%- url_for('/assets/linote-logo.png') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  <script defer src="<%- url_for('/js/main.js') %>"></script>
</head>
<body data-root="<%= config.root %>">
  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href="<%- url_for('/') %>" aria-label="Lino笔记首页">Lino<span>笔记</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">菜单</button>
      <nav class="main-nav" id="main-nav" aria-label="主导航">
        <a class="<%= activeHome ? 'active' : '' %>" href="<%- url_for('/') %>" data-nav="home">首页</a>
        <a class="<%= activeArchive ? 'active' : '' %>" href="<%- url_for('/archives/') %>" data-nav="archive">归档</a>
        <a class="<%= activeTags ? 'active' : '' %>" href="<%- url_for('/tags/') %>" data-nav="tags">标签</a>
        <a class="<%= activeLinks ? 'active' : '' %>" href="<%- url_for('/links/') %>" data-nav="links">友链</a>
        <a class="<%= activeAbout ? 'active' : '' %>" href="<%- url_for('/about/') %>" data-nav="about">关于</a>
      </nav>
      <a class="header-cta" href="<%- url_for('/') %>#notes">开始阅读 <span aria-hidden="true">↘</span></a>
    </div>
  </header>

  <main id="app" tabindex="-1"><%- body %></main>

  <footer class="site-footer">
    <div class="footer-main">
      <div>
        <a class="wordmark footer-wordmark" href="<%- url_for('/') %>">Lino<span>笔记</span></a>
        <p><%= footerCopy.slogan %></p>
      </div>
      <div class="footer-links">
        <a href="<%- url_for('/about/') %>"><%= footerCopy.aboutLinkLabel %></a>
        <a href="<%- url_for('/privacy/') %>"><%= footerCopy.privacyLinkLabel %></a>
        <a href="<%- url_for('/tags/') %>"><%= footerCopy.tagsLinkLabel %></a>
        <a href="<%- url_for('/links/') %>"><%= footerCopy.friendsLinkLabel %></a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span id="year"><%= new Date().getFullYear() %></span> Lino笔记</span>
      <span><%= footerCopy.bottomLine %> <span class="footer-star">✳︎</span></span>
    </div>
  </footer>
  <button class="back-to-top" id="back-to-top" type="button" aria-label="回到顶部">↑</button>
<% if (rewardCopy) { %>
  <button class="reward-fab" id="reward-fab" type="button" aria-haspopup="dialog" aria-controls="reward-dialog" aria-label="<%= rewardCopy.buttonLabel %>" title="<%= rewardCopy.buttonLabel %>"><span aria-hidden="true"><%= rewardCopy.buttonText %></span></button>
  <div class="reward-overlay" id="reward-dialog" role="dialog" aria-modal="true" aria-labelledby="reward-title" hidden>
    <div class="reward-panel" tabindex="-1">
      <button class="reward-close" type="button" data-reward-close aria-label="关闭">×</button>
      <p class="reward-kicker">SUPPORT ✳︎</p>
      <h2 id="reward-title"><%= rewardCopy.title %></h2>
      <p class="reward-message"><%= rewardCopy.message %></p>
      <div class="reward-tabs" role="tablist" aria-label="选择收款方式">
        <button class="reward-tab" type="button" role="tab" id="reward-tab-wechat" aria-controls="reward-pane-wechat" aria-selected="true" data-reward-tab="wechat"><%= rewardCopy.wechatLabel %></button>
        <button class="reward-tab" type="button" role="tab" id="reward-tab-alipay" aria-controls="reward-pane-alipay" aria-selected="false" data-reward-tab="alipay"><%= rewardCopy.alipayLabel %></button>
      </div>
      <div class="reward-codes">
        <figure class="reward-code is-wechat active" id="reward-pane-wechat" role="tabpanel" aria-labelledby="reward-tab-wechat" data-reward-pane="wechat">
          <img width="694" height="674" alt="<%= rewardCopy.wechatLabel %>收款码" data-src="<%- versioned_asset('assets/reward/wechat-pay.png') %>" decoding="async">
          <figcaption><span class="reward-dot" aria-hidden="true"></span><%= rewardCopy.wechatLabel %></figcaption>
        </figure>
        <figure class="reward-code is-alipay" id="reward-pane-alipay" role="tabpanel" aria-labelledby="reward-tab-alipay" data-reward-pane="alipay">
          <img width="702" height="720" alt="<%= rewardCopy.alipayLabel %>收款码" data-src="<%- versioned_asset('assets/reward/alipay.png') %>" decoding="async">
          <figcaption><span class="reward-dot" aria-hidden="true"></span><%= rewardCopy.alipayLabel %></figcaption>
        </figure>
      </div>
      <p class="reward-note"><%= rewardCopy.note %></p>
    </div>
  </div>
<% } %>
</body>
</html>
