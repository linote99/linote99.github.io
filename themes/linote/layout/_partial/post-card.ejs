<%
const postTags = post.tags && typeof post.tags.toArray === 'function' ? post.tags.toArray() : [];
const summary = post.summary || strip_html(post.excerpt || post.content || '').slice(0, 180);
%><article class="post-card">
  <time class="post-date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
  <div class="post-body">
    <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
    <p class="post-excerpt"><%= summary %></p>
    <div class="post-meta"><% postTags.forEach((tag) => { %><a class="post-tag" href="<%- url_for(tag.path) %>"><%= tag.name %></a><% }); %></div>
  </div>
  <a class="post-arrow" href="<%- url_for(post.path) %>" aria-label="阅读：<%= post.title %>">↗</a>
</article>
