<%
const posts = site.posts.sort('date', -1).toArray();
const tags = site.tags.sort('name').toArray();
const homeCopy = site.data.home;
%><section class="hero fade-in" aria-labelledby="hero-title">
  <div class="hero-text">
    <div class="eyebrow"><%= homeCopy.eyebrowEnglish %>&nbsp; / &nbsp;<%= homeCopy.eyebrowChinese %></div>
    <h1 id="hero-title"><%= homeCopy.titleLineOne %><br><%= homeCopy.titleLineTwo %><em><%= homeCopy.titleEmphasis %></em></h1>
    <p class="hero-copy"><%= homeCopy.heroCopy %></p>
    <div class="hero-actions"><a class="button-primary" href="#notes"><%= homeCopy.primaryActionLabel %> <span aria-hidden="true">↘</span></a><a class="button-secondary" href="<%- url_for('/tags/') %>"><%= homeCopy.secondaryActionLabel %> <span aria-hidden="true">→</span></a></div>
  </div>
  <div class="hero-art"><img src="<%- url_for('/assets/linote-logo.png') %>" alt="Lino笔记标志"><div class="art-caption"><span>LINO笔记 / NOTEBOOK Nº 01</span><span>EST. 2026</span></div><div class="art-mark" aria-hidden="true">✳</div></div>
</section>
<div class="hero-rule"></div>
<div class="quick-note"><span class="spark" aria-hidden="true">✳</span><span><%= homeCopy.quickNote %></span></div>
<section class="content-wrap" id="notes" aria-labelledby="notes-title">
  <div class="section-head"><div><p class="section-kicker"><%= homeCopy.sectionKicker %></p><h2 id="notes-title"><%= homeCopy.sectionTitle %></h2><p><%= homeCopy.sectionDescription %></p></div><div class="section-count" id="result-count"><%= String(posts.length).padStart(2, '0') %> NOTES</div></div>
  <div class="filter-row">
    <div class="tag-list" id="tag-filter" aria-label="筛选标签">
      <button class="tag-pill selected" type="button" data-tag=""><%= homeCopy.allTagsLabel %> <span class="tag-num"><%= posts.length %></span></button>
      <% tags.forEach((tag) => { const count = tag.posts.toArray().length; %><button class="tag-pill" type="button" data-tag="<%= tag.name %>"><%= tag.name %> <span class="tag-num"><%= count %></span></button><% }); %>
    </div>
    <label class="search-box"><span class="search-icon" aria-hidden="true">⌕</span><input id="search" type="search" placeholder="<%= homeCopy.searchPlaceholder %>" aria-label="搜索笔记"></label>
  </div>
  <div id="post-list" class="post-list">
    <% posts.forEach((post) => { %><%- partial('_partial/post-card', { post }) %><% }); %>
  </div>
  <div id="pagination" class="pagination" aria-label="笔记分页"></div>
  <noscript><p>启用 JavaScript 后可使用搜索和分页。</p></noscript>
</section>
